# Copy this file to backend/.env (or configure the variables in your host's
# dashboard) and fill in real values. NEVER commit real configuration here.

# Comma-separated list of frontend origins allowed to call this backend.
# Leave unset for local development (any origin, matches the old behaviour).
# Production must always set this explicitly, for example:
ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Transformer result cache (see README section "Transformer result cache").
# CDF_TR_CACHE set to 0/false/no/off disables caching entirely (always retrain).
# CDF_TR_CACHE_TTL is the entry lifetime in seconds (default 900 = 15 minutes).
# Correctness never depends on these: new bars always retrain via the cache key.
# CDF_TR_CACHE=1
# CDF_TR_CACHE_TTL=900

# ---------------------------------------------------------------------------
# Multi-provider market data (all optional; the default config is Yahoo-only)
# ---------------------------------------------------------------------------
# Yahoo Finance (yfinance) needs no key and is always available.
# Twelve Data and Alpha Vantage activate only when an API key is configured.
# Keys are read server-side only and are never sent to the frontend, logs or
# API responses. Get free keys at:
#   https://twelvedata.com/   (free plan: 8 credits/min, 800/day, US-only)
#   https://www.alphavantage.co/support/#api-key  (free: 25 req/day, 5/min)
# TWELVEDATA_API_KEY=
# ALPHAVANTAGE_API_KEY=

# Capability gates (kept OFF by default for honesty; see README):
# ... with a plan that genuinely covers NSE/BSE on Twelve Data
# TWELVEDATA_ENABLE_INDIA=0
# ... only after you have live-verified NSE history with your own key
# ALPHAVANTAGE_ENABLE_NSE=0
# ... free-tier intraday history is plan-dependent; daily/weekly/monthly only
# ALPHAVANTAGE_ENABLE_INTRADAY=0

# Client-side quota budgets (defaults match each provider's free tier):
# TWELVEDATA_MAX_REQUESTS_PER_MINUTE=8
# ALPHAVANTAGE_MAX_REQUESTS_PER_DAY=25
# ALPHAVANTAGE_MAX_REQUESTS_PER_MINUTE=5

# Routing across the enabled pool: round_robin (default) | weighted | first_available
# CDF_MARKET_ROUTING=round_robin
# Weighted mode weights (any integer >= 0). Defaults: 60 / 25 / 15.
# CDF_PROVIDER_WEIGHT_YAHOO=60
# CDF_PROVIDER_WEIGHT_TWELVEDATA=25
# CDF_PROVIDER_WEIGHT_ALPHAVANTAGE=15

# Per-provider on/off overrides (missing credentials already disable a provider)
# CDF_ENABLE_YAHOO=1
# CDF_ENABLE_TWELVEDATA=1
# CDF_ENABLE_ALPHAVANTAGE=1

# Shared cache: 0 disables caching entirely (every request fetches upstream).
# CDF_MARKET_CACHE=1
# CDF_MARKET_CACHE_MAX_ENTRIES=512
# Stale fallback policy: when every provider fails AND a previous successful
# cache entry exists, serve it clearly labelled as stale. The entry may be at
# most CDF_MARKET_STALE_MAX_HOURS old (default 24).
# CDF_MARKET_STALE_FALLBACK=1
# CDF_MARKET_STALE_MAX_HOURS=24

# Host/port are normally supplied by the platform (Procfile uses $PORT);
# they are only needed when running uvicorn by hand in production.
# PORT=8000
